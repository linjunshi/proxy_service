# The one place every deployment setting for this stack is written down.
# Copy to .env and edit. Nothing else carries a default: if a value is
# missing, the command fails and says so, rather than quietly running on a
# different number than the one you think is in effect.
#
# After a change: docker compose up -d   (recreates only what changed)

# ---- Ports ----------------------------------------------------------------

# noVNC GUI, published on the host loopback: http://127.0.0.1:<port>/vnc.html
WMSXWD_GUI_PORT=6080

# The proxy. ONE number, and three things must agree on it:
#   1. the mixed port the application binds   (set in the app GUI)
#   2. http://127.0.0.1:<port>                (host loopback)
#   3. http://wmsxwd:<port>                   (order_process containers)
#
# The application owns it, so change it in the app GUI first, then here. The
# app must also have LAN access enabled, or it binds 127.0.0.1 only and peers
# get connection-refused. Neither mistake is silent: the healthcheck connects
# through the container's own wmsxwd service name -- the same path peers take
# -- so a wrong port or LAN access left off turns the container unhealthy
# within ~15 s.
WMSXWD_PROXY_PORT=6478

# ---- Behavior -------------------------------------------------------------

# 0 stops the supervised watchdog from verifying and repairing the tunnel.
WMSXWD_AUTO_CONNECT=1

# The file must exist. Eight printable ASCII characters turns on VNC
# authentication; empty (or whitespace only) turns it off and the GUI accepts
# any connection -- including from every container on order_process.
VNC_PASSWORD_FILE=./secrets/vnc_password.txt

# Not settings, and deliberately not here: the payload version and its
# SHA-256 live in the Dockerfile beside the checksum that enforces them, and
# the internal VNC port (5901) is never exposed or dialled by anything outside
# the container, so it stays a fixed detail of the image.
