# The one place every deployment setting for this stack is written down. Copy to
# .env and fill in the account. Nothing else carries a default here: a missing
# value fails the command and says so, rather than quietly running on a different
# number than the one you think is in effect.
#
# After a change: docker compose up -d   (recreates only what changed)

# ---- The panel account ----------------------------------------------------

# These three are the durable secret. The subscription URL they yield rotates its
# host every few hours, so nothing else can be saved in its place.
PANEL_BASE_URL=https://api.wmsxwd-3.men
PANEL_EMAIL=
PANEL_PASSWORD=

# ---- The proxy ------------------------------------------------------------

# The mixed port, on the host loopback and on order_process alike. Consumers dial
# http://proxy_service:1082; the Windows host dials http://127.0.0.1:1082.
#
# The core binds it in mihomo/config.yaml (`mixed-port`) -- mihomo cannot read an
# environment variable, so the two must be changed together. The mistake is not
# silent: the healthcheck fetches through this port from inside the core's own
# container, so a disagreement turns proxy_service unhealthy within 30 s.
PROXY_PORT=1082

# ---- Which nodes this deployment may use ----------------------------------

# A regex over the node's name. Gemini refuses some exit countries outright, so
# this is a correctness setting and not a preference. Every country named here also
# needs a group in mihomo/config.yaml before the rotator can park on it; one that
# matches no node is simply skipped.
PROXY_REGION_FILTER=日本|美国|台湾|韩国|德国|印度

# Optional. Node names carry a traffic multiplier (-×1-, -×2-); on a 100 GiB plan
# a ×3 node spends three times the quota per byte.
#PROXY_REGION_EXCLUDE=×[2-9]

# Below this many matching nodes the refresher refuses to publish and keeps the
# list it already has. Raise it if a single node is not enough to serve a burst.
PROXY_MIN_NODES=1

# ---- Refresh cadence ------------------------------------------------------

# The provider asks for 24 h, but the subscription host rotates faster than that
# and a cycle costs one login and one download.
REFRESH_INTERVAL_SECONDS=1800
RETRY_INTERVAL_SECONDS=300

# ---- Country rotation -----------------------------------------------------

# How long one country serves before the rotator moves on. The point is that no
# single exit IP faces the consumer's upstream long enough to be worth blocking,
# so this trades a little latency (the next country is rarely the fastest) for
# not being recognised. Minimum 60.
#
# Which countries are in play is mihomo/config.yaml's PROXY group; a country whose
# nodes are all dead is skipped, not served, and one that dies mid-window is left
# within seconds rather than at the next switch.
PROXY_ROTATION_SECONDS=900

# Spread each switch over ±this many seconds, so the changeover is not a clean
# quarter hour anyone could set a watch by. At most half of the window; 0 disables.
PROXY_ROTATION_JITTER_SECONDS=90

# ---- Pinning a unit of work to one exit -----------------------------------

# The rotator answers GET /current here, inside the core's network namespace, so
# consumers reach it at proxy_service:1083 on order_process and the host does not.
# Asking it which country to name in the proxy username is how one unit of work keeps
# one exit while the rotation moves on for everyone else. README, "Pinning a unit of
# work to one exit".
PROXY_CURRENT_PORT=1083

# ---- The core's control API -----------------------------------------------

# Bound to 127.0.0.1 inside the core's container and published nowhere, so this is
# defence in depth. Empty means no authentication; `make status` sends it either way.
MIHOMO_API_SECRET=
