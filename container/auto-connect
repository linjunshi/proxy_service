#!/bin/bash
# Supervised watchdog: keep the tunnel up without a human -- continuously, not
# only at boot. It verifies first and escalates only on a confirmed failure:
#
#   verify -> clean-slate app restart -> verify -> press start once -> verify
#
# Known application defects on this platform (probed live, do not "fix" by
# clicking harder): the in-app status pill can show 未连接 while the tunnel
# works, and the start button silently no-ops whenever any core process
# already holds the mixed/API ports. Repeated blind presses only race the
# app's core manager into a spawn-retry loop -- hence the doubling backoff
# after a repair round that did not help.
#
# Health is judged two ways, because each misses what the other catches:
#   - exit-IP comparison: a listening port proves nothing, since a
#     disconnected core happily serves DIRECT rules.
#   - a CONNECT probe: plain HTTP proxying can keep working while CONNECT --
#     the path every HTTPS consumer takes -- fails.
set -u

if [ "${WMSXWD_AUTO_CONNECT:?set by compose from .env}" != "1" ]; then
    echo "auto-connect: disabled via WMSXWD_AUTO_CONNECT"
    exit 0
fi

mixed_port="${WMSXWD_PROXY_PORT:?set by compose from .env}"

# Tuning, deliberately not env-configurable: `make recover` already forces an
# immediate re-check, which is the only reason anyone would reach for a knob.
check_interval=120
# The full verdict needs a third-party IP service, so it runs on a slower
# cadence than the local CONNECT probe -- or immediately, whenever that probe
# reports trouble.
verdict_interval=600
backoff_ceiling=900

log() { printf 'auto-connect: %s\n' "$*"; }

# Prints the public IPv4 observed either directly or through the mixed port.
public_ip() {
    local mode="$1" host path response ip
    for endpoint in "api.ipify.org /" "ifconfig.me /ip"; do
        host="${endpoint% *}"
        path="${endpoint#* }"
        if [ "${mode}" = proxy ]; then
            response=$(timeout 8 bash -c "exec 3<>/dev/tcp/127.0.0.1/${mixed_port} \
                && printf 'GET http://${host}${path} HTTP/1.0\r\nHost: ${host}\r\n\r\n' >&3 \
                && cat <&3" 2>/dev/null)
        else
            response=$(timeout 8 bash -c "exec 3<>/dev/tcp/${host}/80 \
                && printf 'GET ${path} HTTP/1.0\r\nHost: ${host}\r\n\r\n' >&3 \
                && cat <&3" 2>/dev/null)
        fi
        ip=$(printf '%s' "${response}" | tail -1 | tr -d '\r' | tr -d '[:space:]')
        if [[ "${ip}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
            printf '%s' "${ip}"
            return 0
        fi
    done
    return 1
}

# Does the proxy still open tunnels? Only its own answer is read; completing a
# TLS handshake is not this script's job.
connect_established() {
    local status_line
    for host in api.ipify.org www.google.com; do
        status_line=$(timeout 8 bash -c "exec 3<>/dev/tcp/127.0.0.1/${mixed_port} \
            && printf 'CONNECT ${host}:443 HTTP/1.1\r\nHost: ${host}:443\r\n\r\n' >&3 \
            && head -n 1 <&3" 2>/dev/null)
        case "${status_line}" in *" 200 "*) return 0 ;; esac
    done
    return 1
}

# 0 = healthy, 1 = needs repair, 2 = cannot judge.
# The direct baseline comes first: without it a disconnected core serving
# DIRECT rules looks identical to a working tunnel, and a machine-wide outage
# would otherwise be misread as an application fault and restart it for nothing.
tunnel_state() {
    local proxied direct
    direct=$(public_ip direct) || direct=$(public_ip direct) || return 2
    proxied=$(public_ip proxy) || return 1
    connect_established || return 1
    [ "${proxied}" != "${direct}" ]
}

# Polls tunnel_state every few seconds for up to $1 seconds. Returns its final
# code. The window must be generous: after an app start the core manager can
# churn for a couple of minutes before settling.
verify_within() {
    local deadline=$(( SECONDS + $1 )) state
    while true; do
        tunnel_state
        state=$?
        [ "${state}" -ne 1 ] && return "${state}"
        [ "${SECONDS}" -ge "${deadline}" ] && return 1
        sleep 5
    done
}

wait_for_window() {
    window_id=""
    for _ in $(seq 1 60); do
        window_id=$(xdotool search --onlyvisible --name wmsxwd 2>/dev/null | head -1)
        [ -n "${window_id}" ] && return 0
        sleep 2
    done
    return 1
}

# Positions are fractions of the window: bottom-nav home tab, then the round
# start button on the home view. Escape first: a modal announcement eats
# clicks. A press only works when no core holds the app's ports, so this is
# strictly the last resort (it covers a saved state of "disabled", where the
# app starts no core and the button is live).
press_start() {
    local WINDOW X Y WIDTH HEIGHT SCREEN
    xdotool windowactivate --sync "${window_id}" 2>/dev/null
    xdotool key Escape
    sleep 1
    eval "$(xdotool getwindowgeometry --shell "${window_id}")"
    xdotool mousemove $((X + WIDTH * 2575 / 10000)) $((Y + HEIGHT * 897 / 1000)) click 1
    sleep 2
    xdotool mousemove $((X + WIDTH / 2)) $((Y + HEIGHT * 344 / 1000)) click 1
}

# Returns a tunnel_state code, so the caller can report what actually
# happened rather than assuming the repair worked.
repair() {
    local state
    wait_for_window || { log "application window is not present" >&2; return 1; }

    log "clean-slate restart of the application"
    recover-app --app-only
    wait_for_window || { log "application window did not return after restart" >&2; return 1; }

    verify_within 150
    state=$?
    [ "${state}" -ne 1 ] && return "${state}"

    log "still down; pressing start once as a last resort"
    press_start
    verify_within 90
}

log "watchdog started (CONNECT probe every ${check_interval}s, full verdict every ${verdict_interval}s)"

wait_for_window || log "application window has not appeared yet" >&2
log "verifying tunnel (the app restores its saved connection state by itself)"

state=0
last_state=-1
backoff="${check_interval}"

# Only state changes are announced, so a steady tunnel stays quiet while a
# change -- including "I can no longer tell" -- is never lost in repetition.
announce() {
    [ "${state}" -eq "${last_state}" ] && return 0
    last_state=${state}
    case "${state}" in
        0) log "tunnel is up (verified by exit-IP comparison and a CONNECT probe; the in-app 未连接 pill is unreliable and can be ignored)" ;;
        2) log "cannot judge the tunnel: no direct baseline to compare against, so it is left alone (a live tunnel must not be toggled)" >&2 ;;
    esac
}

verify_within 150
state=$?
announce
last_full_check=${SECONDS}

while true; do
    # An already-known-bad state goes straight to repair: a disconnected core
    # still answers CONNECT from its DIRECT rules, so re-probing here would
    # hide the failure the previous verdict already established.
    if [ "${state}" -ne 1 ]; then
        # The cheap probe runs every cycle. The full verdict is what decides,
        # but it needs a third-party IP service, so it runs on a slower
        # cadence -- or at once, the moment the cheap probe reports trouble.
        if connect_established && [ $(( SECONDS - last_full_check )) -lt "${verdict_interval}" ]; then
            sleep "${check_interval}"
            continue
        fi

        last_full_check=${SECONDS}
        tunnel_state
        state=$?
    fi

    if [ "${state}" -eq 1 ]; then
        log "tunnel is down; repairing"
        repair
        state=$?
    fi
    announce

    if [ "${state}" -eq 1 ]; then
        log "repair did not restore the tunnel. Likely causes: not logged in, no node selected, or the provider's entry servers are unreachable. Open the GUI (noVNC), check login and node. Retrying in ${backoff}s." >&2
        sleep "${backoff}"
        backoff=$(( backoff * 2 ))
        [ "${backoff}" -gt "${backoff_ceiling}" ] && backoff="${backoff_ceiling}"
        continue
    fi

    backoff="${check_interval}"
    sleep "${check_interval}"
done
