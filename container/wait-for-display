#!/bin/sh
set -eu

attempt=0
max_attempts=60

until xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1; do
    attempt=$((attempt + 1))

    if [ "${attempt}" -ge "${max_attempts}" ]; then
        echo "The virtual display ${DISPLAY} did not become ready." >&2
        exit 1
    fi

    sleep 1
done

exec "$@"
